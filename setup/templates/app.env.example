# App Vercel project: use these four browser-safe values in its Production environment.
# Local app: the setup command writes these to the ignored .env.local file.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_APP_ORIGIN=https://YOUR_APP.vercel.app
VITE_QUIZ_RUNNER_ORIGIN=https://YOUR_RUNNER.vercel.app
